#ifndef _TRIGONOMETRY_HM
#define _TRIGONOMETRY_HM

#include <metal_stdlib>
using namespace metal;

// Based on:
// https://github.com/schuttejoe/Selas/blob/56a7fab5a479ec93d7f641bb64b8170f3b0d3095/Source/Core/MathLib/Trigonometric.h#L56
// By Selas (Joe Schutte)
// modified by ronja to fit a Z-UP tangent space 
//


// NOTE: ASSUMES VECTORS ARE Z-UP 

inline float CosTheta(float3 w)
{
    return w.z;
}

inline float Cos2Theta(float3 w)
{
    return w.z * w.z;
}

inline float AbsCosTheta(float3 w)
{
    return abs(CosTheta(w));
}

inline float Sin2Theta(float3 w)
{
    return max(0.f, 1.f - Cos2Theta(w));
}

inline float SinTheta(float3 w)
{
    return sqrt(Sin2Theta(w));
}

inline float TanTheta(float3 w)
{
    return SinTheta(w) / CosTheta(w);
}

inline float Tan2Theta(float3 w)
{
    return Sin2Theta(w) / Cos2Theta(w);
}

inline float CosPhi(float3 w)
{
    float sin_theta = SinTheta(w);
    return (sin_theta == 0) ? 1.f : clamp(w.x / sin_theta, -1.f, 1.f);
}

inline float SinPhi(float3 w)
{
    float sin_theta = SinTheta(w);
    return (sin_theta == 0) ? 1.f : clamp(w.y / sin_theta, -1.f, 1.f);
}

inline float Cos2Phi(float3 w)
{
    float cos_phi = CosPhi(w);
    return cos_phi * cos_phi;
}

inline float Sin2Phi(float3 w)
{
    float sin_phi = SinPhi(w);
    return sin_phi * sin_phi;
}


#endif // _TRIGONOMETRY_HM
