inline float3 do_lighting(Material material, float3x3 to_tangent, float3 fragPos, float3 camPos, Sun sun, constant PointLight *lights)
{
    float3 viewDir = normalize(to_tangent * normalize(camPos - fragPos));
    float3 reflection = 0.0;
    for(int i = 0; i < MAX_NO_LIGHTS; i++)
    {
        float3 lightVec = lights[i].pos - fragPos;
        float3 lightDir = normalize(lightVec);
        float dist = length(lightVec);
        float falloff = light_falloff(dist, lights[i].falloff, 1.0);
        reflection += lights[i].color * falloff * EvaluateDisney(material, viewDir, lightDir, false, 1.f, 1.f);
    }

    float3 sunDir = normalize(to_tangent * normalize(sun.sun_dir));
    reflection += sun.sun_color * EvaluateDisney(material, viewDir, sunDir, false, 0.f, 0.f);
    
    return reflection;
}
#endif // _LIGHTING_METAL
