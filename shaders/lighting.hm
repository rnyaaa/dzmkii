#ifndef _LIGHTING_HM
#define _LIGHTING_HM

#include <metal_stdlib>
#include "noise.hm"
#include "bsdf.hm"
using namespace metal;
#define MAX_NO_LIGHTS 50

struct PointLight
{
    packed_float3 pos;
    packed_float3 color;
    float falloff;
};

inline float light_falloff(float distance, float lightRadius, float scale) {
    distance = distance / scale;
    return pow(clamp(1 - pow(distance/lightRadius, 4), 0.0, 1.0),2) / (pow(distance, 2) + 1);
}

